# ── Database
DATABASE_URL=postgresql://money_manager:changeme@localhost:15432/money_manager
POSTGRES_USER=money_manager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=money_manager

# ── API
NODE_ENV=development
API_PORT=3001
# openssl rand -base64 32
JWT_ACCESS_SECRET=
# openssl rand -base64 32
JWT_REFRESH_SECRET=
INTERNAL_API_KEY=dev-internal-key-change-me
CORS_ORIGINS=http://localhost:5173
RUN_DB_MIGRATIONS=true

# ── Web
VITE_API_URL=http://localhost:3001

# ── Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=botSemArroba
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=true
BOT_PORT=3002
API_INTERNAL_URL=http://localhost:3001

# ── STT (faster-whisper local — serviço apps/stt)
STT_MODEL=small
STT_LANGUAGE=pt
STT_NOISE_REDUCTION=false

# ── Chaves por usuário (Brapi / CoinGecko) — configuradas em Settings, não aqui
# ── Criptografia de credenciais por usuário
SETTINGS_ENCRYPTION_KEY=
